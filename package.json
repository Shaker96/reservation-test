{
  "name": "reservation-service",
  "version": "1.0.0",
  "private": true,
  "description": "POST /reservations endpoint that stays correct under retries, concurrency and tenant boundaries.",
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:setup": "tsx scripts/db-setup.ts",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
